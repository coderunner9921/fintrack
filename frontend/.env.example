# FRONTEND-ONLY, non-secret settings (Vite exposes variables prefixed VITE_ to the browser bundle).
# Leave empty during development: the app calls /api/... and the Vite proxy forwards to http://localhost:8083.
# Only set an absolute URL if the backend has CORS configured for your origin (it currently does not).
# Never put passwords, JWT secrets or tokens in this file.
VITE_API_BASE_URL=
